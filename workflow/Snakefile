rule all:
    input:
        reads_loss_summary='<results>/reads_loss_summary.tsv',
        fa='<results>/ASVs.fa',
        counts='<results>/ASVs_counts.tsv',
        tax='<results>/ASVs_taxa.tsv',
        ab_report='<reports>/alpha_beta.pdf',
        pathways='<results>/picrust2/KO_metagenome_out/pred_metagenome_unstrat.tsv.gz'

rule filter:
    input: expand("<samples_filter>/{sample}_R{n}.fastq.gz", sample=SRA_RUNS, n=[1, 2])